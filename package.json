{
  "name": "dsh-effect-doctor",
  "version": "0.1.0",
  "description": "Verify that Cordis-managed runtime resources return to baseline after plugin teardown.",
  "type": "module",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./dsh-plugin": {
      "types": "./dist/src/dsh-plugin.d.ts",
      "default": "./dist/src/dsh-plugin.js"
    }
  },
  "bin": {
    "dsh-effect-doctor": "./dist/src/cli.js"
  },
  "files": [
    "cordis.patch.yml",
    "dist/src/**/*.d.ts",
    "dist/src/**/*.js",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gate:real": "node dist/scripts/real-gate.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/tests/contracts.test.js dist/tests/engine.test.js dist/tests/receipt-viewer.test.js dist/tests/dsh-plugin.test.js dist/tests/bundle.test.js",
    "test:real": "node --test dist/tests/real-cordis.test.js",
    "verify:cli": "node dist/src/cli.js --help",
    "verify": "npm run typecheck && npm run build && npm run test && npm run verify:cli && npm run test:real && npm run gate:real"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
